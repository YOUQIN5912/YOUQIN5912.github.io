          "language": "bash",
          "text": "module load VASP/5.4.4-intel-2019a-std-vtst\ncp -r 00 01 02 $SCRATCH\nsavefile 01/CONTCAR 01/OUTCAR 01/DOSCAR 01/CHGCAR 01/WAVECAR"
        },
        {
          "language": "bash",
          "text": "for i in {01..05}; do\n    for file in CONTCAR OUTCAR DOSCAR CHGCAR WAVECAR; do\n        cleanup cp $i/$file $SLURM_SUBMIT_DIR/$i/$file\n    done\ndone"
        },
