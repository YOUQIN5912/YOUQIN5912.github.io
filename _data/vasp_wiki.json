          "language": "bash",
          "text": " module load intel-compilers/2022.1.0 "
        },
        {
          "language": "bash",
          "text": " module load imkl/2022.1.0 "
        },
        {
          "language": "bash",
          "text": " make -f Makefile.ifort atomsk "
        }
